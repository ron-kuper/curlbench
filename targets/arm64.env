# curlbench target profile: arm64.
#
# Toolchain: the distribution cross packages, so a result here is reproducible
# by anyone from a package name rather than from a vendor SDK.
#
#   Debian/Ubuntu:  apt install gcc-11-aarch64-linux-gnu
#   Fedora:         dnf install gcc-aarch64-linux-gnu
#
# Install the VERSIONED package. The unversioned gcc-aarch64-linux-gnu
# metapackage is uninstallable on Ubuntu 22.04 (it is pinned at 11.2.0 while
# the archive moved the real package to 11.4.0, and apt refuses to bridge
# that); it is also the only thing that provides the unversioned
# aarch64-linux-gnu-gcc symlink, hence the fallback below.
#
# The compiler package pulls in the cross libc development files, including the
# static libc the default STATIC=1 link needs.
#
# Tuned for Cortex-A55, an ARMv8.2-A in-order core. The tuning is not cosmetic:
# the -mcpu=generic default schedules for out-of-order execution, which hides
# per-byte and per-call latency that an in-order core pays in full -- and that
# latency is exactly what several of these patches are about. Change -mcpu= to
# match whichever core the numbers will be quoted for.
#
# The cross glibc is whatever the distribution ships (Ubuntu 22.04: 2.35, which
# needs kernel 3.2 or newer). Check `uname -r` on the target before assuming a
# static binary will start.

CB_HOST="aarch64-linux-gnu"
CB_CFLAGS="-O2 -g -mcpu=cortex-a55"
if [ -z "$CB_CC" ]; then
  if command -v aarch64-linux-gnu-gcc >/dev/null 2>&1; then
    CB_CC="aarch64-linux-gnu-gcc"
  else
    CB_CC="aarch64-linux-gnu-gcc-11"
  fi
fi
CB_NOTE="arm64, Cortex-A55 (ARMv8.2-A, in-order)"
